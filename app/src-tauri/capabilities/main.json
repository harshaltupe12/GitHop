{
  "identifier": "main",
  "description": "Main GitHop window. App commands plus the few local-only plugin calls the UI needs. No fs, shell, http, process or opener permissions: links open Rust-side through open_external (fixed URLs).",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-state",
    "allow-list-profiles",
    "allow-validate-profile",
    "allow-save-profile",
    "allow-delete-profile",
    "allow-set-default",
    "allow-suggest-key-path",
    "allow-generate-key",
    "allow-read-public-key",
    "allow-test-connection",
    "allow-scan",
    "allow-cancel-scan",
    "allow-pin",
    "allow-unpin",
    "allow-pin-all",
    "allow-hooks-snippet",
    "allow-fix-plan",
    "allow-fix-apply",
    "allow-fix-undo",
    "allow-doctor",
    "allow-save-diagnostics",
    "allow-update-settings",
    "allow-install-hooks",
    "allow-wipe",
    "allow-export-profiles",
    "allow-import-preview",
    "allow-import-apply",
    "allow-restore-profiles-backup",
    "allow-open-external",
    "allow-app-info",
    "allow-show-main",
    "allow-quit-app",
    "dialog:allow-open",
    "dialog:allow-save",
    "clipboard-manager:allow-write-text"
  ]
}
