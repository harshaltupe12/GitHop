{
  "productName": "GitHop",
  "mainBinaryName": "GitHopApp",
  "version": "0.1.0",
  "identifier": "dev.githop.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "GitHop",
        "url": "index.html",
        "width": 880,
        "height": 600,
        "minWidth": 720,
        "minHeight": 520,
        "center": true,
        "resizable": true,
        "decorations": true,
        "visible": false,
        "focus": true,
        "theme": "Light",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-networking --disable-component-update --disable-domain-reliability --no-pings --disable-sync"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'",
      "capabilities": ["main", "tray"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "GitHop",
    "copyright": "GitHop contributors",
    "category": "DeveloperTool",
    "shortDescription": "One git identity per repo, automatically.",
    "longDescription": "GitHop gives each git identity its own name, email and SSH key, picks the right one per repo and blocks commits and pushes made with the wrong identity. It works offline.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh",
        "customLanguageFiles": { "English": "./windows/English.nsh" },
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
