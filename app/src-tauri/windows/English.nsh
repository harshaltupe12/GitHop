LangString chooseHowToInstall ${LANG_ENGLISH} "Choose how to install ${PRODUCTNAME}."
LangString createDesktop ${LANG_ENGLISH} "Create a desktop shortcut"
LangString dontUninstall ${LANG_ENGLISH} "Don't uninstall"
LangString dontUninstallDowngrade ${LANG_ENGLISH} "Don't uninstall (not available when installing an older version)"
LangString failedToKillApp ${LANG_ENGLISH} "Couldn't close {{product_name}}. Close it, then try again."
LangString installingWebview2 ${LANG_ENGLISH} "Installing WebView2..."
LangString newerVersionInstalled ${LANG_ENGLISH} "A newer version of ${PRODUCTNAME} is already installed. Installing an older version isn't recommended. If you want to, uninstall the newer version first. Your profiles and settings are kept. Choose what to do, then click Next."
LangString older ${LANG_ENGLISH} "older"
LangString olderOrUnknownVersionInstalled ${LANG_ENGLISH} "An $R4 version of ${PRODUCTNAME} is installed. Uninstalling it first is recommended. Your profiles and settings are kept. Choose what to do, then click Next."
LangString silentDowngrades ${LANG_ENGLISH} "Downgrades are turned off for this installer, so silent setup can't continue. Run the installer without /S instead.$\n"
LangString unableToUninstall ${LANG_ENGLISH} "GitHop couldn't be uninstalled."
LangString uninstallApp ${LANG_ENGLISH} "Uninstall first, then reinstall"
LangString uninstallBeforeInstalling ${LANG_ENGLISH} "Uninstall the old version first"
LangString unknown ${LANG_ENGLISH} "unknown"
LangString webview2AbortError ${LANG_ENGLISH} "WebView2 couldn't be installed, and GitHop needs it. Try running setup again."
LangString webview2DownloadError ${LANG_ENGLISH} "WebView2 couldn't be downloaded ($0)."
LangString webview2DownloadSuccess ${LANG_ENGLISH} "WebView2 setup downloaded"
LangString webview2Downloading ${LANG_ENGLISH} "Downloading WebView2 setup..."
LangString webview2InstallError ${LANG_ENGLISH} "WebView2 couldn't be installed (exit code $1)."
LangString webview2InstallSuccess ${LANG_ENGLISH} "WebView2 installed"
